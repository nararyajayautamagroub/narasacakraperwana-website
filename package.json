{
  "name": "narasacakraperwana-website",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "scrape": "tsx scripts/scraper.ts",
    "scrape:check": "tsx scripts/scraper.ts --dry-run"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cheerio": "1.2.0",
    "jose": "6.1.0",
    "next": "16.3.5",
    "next-auth": "4.24.15",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript-eslint": "8.70.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "encoding-sniffer": "^1.0.2"
  }
}
